{
  "name": "voidplayer-windows-x64-msvc",
  "target": "windows-x64",
  "toolchain": "msvc",
  "ffmpegRef": "n8.1",
  "dav1dRef": "1.5.3",
  "externalDependencies": [
    {
      "name": "dav1d",
      "version": "1.5.3",
      "linkage": "static",
      "usedFor": "AV1 software decoding"
    },
    {
      "name": "libssh",
      "source": "vcpkg",
      "triplet": "x64-windows-static-md",
      "linkage": "static",
      "usedFor": "FFmpeg sftp:// protocol"
    }
  ],
  "libraries": [
    "avcodec",
    "avformat",
    "avutil",
    "swresample"
  ],
  "componentPolicy": {
    "enabled": [
      "FFmpeg default demuxers",
      "FFmpeg default decoders",
      "FFmpeg default parsers",
      "FFmpeg default bitstream filters",
      "FFmpeg default built-in protocols",
      "libdav1d AV1 software decoder",
      "D3D11VA/D3D12VA/DXVA2 hardware acceleration",
      "SFTP via static libssh"
    ],
    "disabled": [
      "encoders",
      "muxers",
      "programs",
      "avdevice/devices",
      "avfilter/filters",
      "swscale"
    ]
  },
  "representativeDemuxers": [
    "mov/mp4",
    "matroska/webm",
    "avi",
    "flv",
    "mpegts",
    "mpegps",
    "ogg",
    "asf",
    "wav",
    "raw h264/hevc/vvc"
  ],
  "representativeDecoders": [
    "h264",
    "hevc",
    "vvc/h266",
    "av1",
    "vp8",
    "vp9",
    "mpeg1/2/4",
    "aac",
    "ac3",
    "eac3",
    "dca/dts",
    "truehd",
    "mp1",
    "mp2",
    "mp3",
    "flac",
    "alac",
    "ape",
    "opus",
    "vorbis",
    "pcm"
  ],
  "requiredConfigureSymbols": [
    "CONFIG_VVC_DECODER",
    "CONFIG_AAC_DECODER",
    "CONFIG_AC3_DECODER",
    "CONFIG_EAC3_DECODER",
    "CONFIG_DCA_DECODER",
    "CONFIG_TRUEHD_DECODER",
    "CONFIG_APE_DECODER",
    "CONFIG_MATROSKA_DEMUXER",
    "CONFIG_MOV_DEMUXER",
    "CONFIG_MPEGTS_DEMUXER",
    "CONFIG_D3D12VA",
    "CONFIG_AV1_D3D12VA_HWACCEL",
    "CONFIG_H264_D3D12VA_HWACCEL",
    "CONFIG_HEVC_D3D12VA_HWACCEL",
    "CONFIG_MPEG2_D3D12VA_HWACCEL",
    "CONFIG_VC1_D3D12VA_HWACCEL",
    "CONFIG_VP9_D3D12VA_HWACCEL",
    "CONFIG_WMV3_D3D12VA_HWACCEL"
  ],
  "protocols": [
    "cache",
    "concat",
    "file",
    "http",
    "https",
    "pipe",
    "sftp"
  ]
}
